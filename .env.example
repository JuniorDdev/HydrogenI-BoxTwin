APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
# mock funciona sem hardware; altere para vl53l8cx após integrar o driver físico.
SENSOR_MODE=mock
BOX_NODE_ID=BOX-DEMO-01
BOX_NAME=BoxTwin 3D - prototipo MDF 40x40
BOX_LENGTH_M=0.40
BOX_WIDTH_M=0.40
BOX_HEIGHT_M=0.40
SAMPLE_INTERVAL_SECONDS=5
CAPACITY_ALERT_PERCENT=85
MIN_CONFIDENCE_PERCENT=70
DATABASE_PATH=data/boxtwin.db
CALIBRATION_PATH=data/calibration.json
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Notificações (desativadas por padrão)
NOTIFY_COOLDOWN_SECONDS=300
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ALERT_EMAIL_TO=
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
TWILIO_CONTENT_SID=
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Agente Groq (GroqCloud) com fallback automático para RAG local
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20

# Sincronização Raspberry -> Railway
EDGE_SYNC_ENABLED=false
# Envia periodicamente a matriz bruta 8x8 para /gemeo-sensor, sem calibração nem alertas.
LIVE_SENSOR_SYNC_ENABLED=false
EDGE_SYNC_TARGET_URL=
EDGE_SYNC_TOKEN=
EDGE_SYNC_TIMEOUT_SECONDS=15
EDGE_SYNC_BATCH_SIZE=20
# Heartbeat Raspberry -> API central. EDGE_NODE_TOKENS fica somente no Railway;
# no Raspberry use EDGE_SYNC_TOKEN com a credencial daquele node.
HEARTBEAT_INTERVAL_SECONDS=30
NODE_OFFLINE_AFTER_SECONDS=120
# Exemplo Railway: {"BOX-01":"token-secreto-do-box-01"}
EDGE_NODE_TOKENS={}

# Retenção e limpeza automática
AUTO_CLEANUP_ENABLED=true
READINGS_RETENTION_DAYS=45
NOTIFICATIONS_RETENTION_DAYS=60
INCIDENTS_RETENTION_DAYS=180
SYNC_QUEUE_RETENTION_DAYS=7
