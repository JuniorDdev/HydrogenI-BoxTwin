[Unit]
Description=BoxTwin 3D BoxNode
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/boxtwin
EnvironmentFile=/opt/boxtwin/.env
ExecStart=/opt/boxtwin/.venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

ExecStart=/home/pi/HydrogenI-BoxTwin/.venv/bin/gunicorn --bind 0.0.0.0:5000 --certfile=/home/pi/HydrogenI-BoxTwin/cert.pem --keyfile=/home/pi/HydrogenI-BoxTwin/key.pem --workers 1 --threads 8 --timeout 120 app:app
