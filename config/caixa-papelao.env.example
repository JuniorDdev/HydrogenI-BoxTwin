# Perfil do protótipo apresentativo — caixa de papelão
# Medidas INTERNAS fornecidas: 14,5 cm × 14,5 cm × 15 cm.
# Copie estas variáveis para o arquivo .env do equipamento que executará o painel.

BOX_NODE_ID=BOX-PAPELAO-01
BOX_NAME=BoxTwin 3D - caixa 14,5x14,5x15 cm
BOX_LENGTH_M=0.145
BOX_WIDTH_M=0.145
BOX_HEIGHT_M=0.150
# Distância física entre o sensor e a borda mais próxima: 4,3 cm.
SENSOR_EDGE_DISTANCE_M=0.043

# Use vl53l8cx somente no Raspberry já configurado com o driver ST.
SENSOR_MODE=vl53l8cx
VL53L8CX_MENU_PATH=/caminho/para/VL53L8CX_ULD
